<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Base.CardView" parent="@android:style/Widget">
        <item name="cardCornerRadius">@dimen/cardview_default_radius</item>
        <item name="cardElevation">@dimen/cardview_default_elevation</item>
        <item name="cardMaxElevation">@dimen/cardview_default_elevation</item>
        <item name="cardPreventCornerOverlap">true</item>
        <item name="cardUseCompatPadding">false</item>
    </style>
    <style name="CardView" parent="@style/Base.CardView" />
    <style name="CardView.Dark" parent="@style/CardView">
        <item name="cardBackgroundColor">@color/cardview_dark_background</item>
    </style>
    <style name="CardView.Light" parent="@style/CardView">
        <item name="cardBackgroundColor">@color/cardview_light_background</item>
    </style>
    <style name="KustomDashboardTheme.Dark" parent="@style/KustomDashboardTheme.Dark.Base">
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowSharedElementEnterTransition">@android:transition/move</item>
        <item name="android:windowSharedElementExitTransition">@android:transition/move</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>
    <style name="KustomDashboardTheme.Dark.Base" parent="">
        <item name="android:textColorPrimary">@color/kustom_dashboard_dark_primary_text</item>
        <item name="android:textColorSecondary">@color/kustom_dashboard_dark_secondary_text</item>
        <item name="android:textColorPrimaryInverse">@color/kustom_dashboard_dark_primary_text_inverted</item>
        <item name="android:textColorSecondaryInverse">@color/kustom_dashboard_dark_secondary_text_inverted</item>
        <item name="android:windowBackground">@color/kustom_dashboard_dark_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColorTertiary">@color/kustom_dashboard_dark_tertiary_text</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorPrimary">@color/kustom_dashboard_dark_primary</item>
        <item name="android:colorPrimaryDark">@color/kustom_dashboard_dark_primary_dark</item>
        <item name="android:colorAccent">@color/kustom_dashboard_dark_accent</item>
    </style>
    <style name="KustomDashboardTheme.Dark.Dialog" parent="@style/KustomDashboardTheme.Dark.Base">
        <item name="android:textColor">?android:textColorPrimaryInverseDisableOnly</item>
        <item name="android:background">@color/kustom_dashboard_dark_background</item>
    </style>
    <style name="KustomDashboardTheme.Light" parent="@style/KustomDashboardTheme.Light.Base">
        <item name="android:windowContentTransitions">true</item>
        <item name="android:windowSharedElementEnterTransition">@android:transition/move</item>
        <item name="android:windowSharedElementExitTransition">@android:transition/move</item>
        <item name="android:windowAllowReturnTransitionOverlap">true</item>
        <item name="android:windowAllowEnterTransitionOverlap">true</item>
    </style>
    <style name="KustomDashboardTheme.Light.Base" parent="">
        <item name="android:textColorPrimary">@color/kustom_dashboard_light_primary_text</item>
        <item name="android:textColorSecondary">@color/kustom_dashboard_light_secondary_text</item>
        <item name="android:textColorPrimaryInverse">@color/kustom_dashboard_light_primary_text_inverted</item>
        <item name="android:textColorSecondaryInverse">@color/kustom_dashboard_light_secondary_text_inverted</item>
        <item name="android:windowBackground">@color/kustom_dashboard_light_background</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColorTertiary">@color/kustom_dashboard_light_tertiary_text</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorPrimary">@color/kustom_dashboard_light_primary</item>
        <item name="android:colorPrimaryDark">@color/kustom_dashboard_light_primary_dark</item>
        <item name="android:colorAccent">@color/kustom_dashboard_light_accent</item>
    </style>
    <style name="KustomDashboardTheme.Light.Dialog" parent="@style/KustomDashboardTheme.Light.Base">
        <item name="android:textColor">?android:textColorPrimaryInverseDisableOnly</item>
        <item name="android:background">@color/kustom_dashboard_light_background</item>
    </style>
    <style name="KustomDashboardTheme.Translucent" parent="">
        <item name="android:textColorPrimary">@color/kustom_translucent_background_text_primary</item>
        <item name="android:textColorSecondary">@color/kustom_translucent_background_text_primary</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:textColorTertiary">@color/kustom_translucent_background_text_primary</item>
        <item name="android:windowActionBar">false</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
        <item name="android:colorPrimary">#ff000000</item>
        <item name="android:colorPrimaryDark">@color/kustom_translucent_background</item>
        <item name="android:colorAccent">@color/kustom_translucent_background_text_primary</item>
        <item name="android:statusBarColor">@color/kustom_translucent_background</item>
    </style>
    <style name="TextAppearance.Compat.Notification" parent="@android:style/TextAppearance.Material.Notification" />
    <style name="TextAppearance.Compat.Notification.Info" parent="@android:style/TextAppearance.Material.Notification.Info" />
    <style name="TextAppearance.Compat.Notification.Line2" parent="@style/TextAppearance.Compat.Notification.Info" />
    <style name="TextAppearance.Compat.Notification.Time" parent="@android:style/TextAppearance.Material.Notification.Time" />
    <style name="TextAppearance.Compat.Notification.Title" parent="@android:style/TextAppearance.Material.Notification.Title" />
    <style name="Widget.Compat.NotificationActionContainer" parent="">
        <item name="android:background">@drawable/notification_action_background</item>
    </style>
    <style name="Widget.Compat.NotificationActionText" parent="">
        <item name="android:textAppearance">?android:textAppearanceButton</item>
        <item name="android:textSize">@dimen/notification_action_text_size</item>
        <item name="android:textColor">@color/secondary_text_default_material_light</item>
    </style>
</resources>
