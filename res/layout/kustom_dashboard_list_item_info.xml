<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    n1:layout_gravity="bottom"
    n1:orientation="vertical"
    n1:id="@id/info"
    n1:background="@color/kustom_translucent_background"
    n1:layout_width="fill_parent"
    n1:layout_height="wrap_content"
    xmlns:n1="http://schemas.android.com/apk/res/android">
    <TextView
        n1:textAppearance="@android:style/TextAppearance.Medium"
        n1:textColor="@color/kustom_translucent_background_text_primary"
        n1:ellipsize="marquee"
        n1:id="@id/title"
        n1:paddingLeft="6.0dip"
        n1:paddingTop="8.0dip"
        n1:paddingRight="4.0dip"
        n1:paddingBottom="0.0dip"
        n1:fadingEdge="horizontal"
        n1:layout_width="fill_parent"
        n1:layout_height="wrap_content"
        n1:singleLine="true" />
    <TextView
        n1:textAppearance="@android:style/TextAppearance.Small"
        n1:textColor="@color/kustom_translucent_background_text_secondary"
        n1:ellipsize="marquee"
        n1:layout_gravity="top"
        n1:id="@id/author"
        n1:paddingLeft="6.0dip"
        n1:paddingTop="0.0dip"
        n1:paddingRight="4.0dip"
        n1:paddingBottom="8.0dip"
        n1:fadingEdge="horizontal"
        n1:layout_width="fill_parent"
        n1:layout_height="wrap_content"
        n1:singleLine="true" />
</LinearLayout>